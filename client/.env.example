# ─────────────────────────────────────────────────────────────────────────
# Book A Sloth — CLIENT environment template (Vite)
# Copy to `client/.env` for local dev. In production these are set in the
# Vercel dashboard (Project Settings → Environment Variables).
#
# ⚠️  Anything prefixed VITE_ is BUNDLED INTO THE PUBLIC BROWSER BUNDLE.
#     Only put publishable / non-secret keys here. NEVER a service-role key,
#     Razorpay key SECRET, or SMTP password.
# ─────────────────────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:5000        # PROD: https://api.yourdomain.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=                    # publishable anon key (safe in browser)
VITE_RAZORPAY_KEY_ID=                      # publishable key id (safe in browser)
