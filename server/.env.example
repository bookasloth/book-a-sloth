# ─────────────────────────────────────────────────────────────────────────
# Book A Sloth — SERVER environment template
# Copy to `server/.env` for local dev. In production these are set in the
# Render dashboard (Environment tab), NOT committed. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────

# ── Core ──
NODE_ENV=development                      # set to "production" on Render
PORT=5000                                 # Render injects its own PORT; leave default locally
CLIENT_URL=http://localhost:5173          # PROD: https://yourdomain.com  (locks CORS)
API_URL=http://localhost:5000             # PROD: https://api.yourdomain.com

# ── Supabase (DB / Auth) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=                        # public-safe key
SUPABASE_SERVICE_ROLE_KEY=                # SECRET — full DB access, server only
SUPABASE_JWT_SECRET=                      # only used by scripts/measure-me.js

# ── App secrets (generate strong random values; rotate if ever leaked) ──
SUPER_ADMIN_JWT_SECRET=                   # signs admin-panel JWTs
OAUTH_STATE_SECRET=                       # signs Google OAuth state param
GOOGLE_TOKEN_KEY=                         # encrypts stored Google refresh tokens (32-byte key)

# ── Google Calendar OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback   # PROD: https://api.yourdomain.com/...

# ── Razorpay (payments) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                      # SECRET
RAZORPAY_WEBHOOK_SECRET=                  # SECRET — verifies payment.captured webhook

# ── Email (SMTP — primary provider) ──
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=                               # SECRET — app password, not account password

# ── Email (optional alt providers; leave blank if unused) ──
RESEND_API_KEY=
RESEND_FROM=
AWS_REGION=
SES_FROM=

# ── Admin / alerts ──
ADMIN_ALERT_EMAIL=
SUPER_ADMIN_EMAIL=

# ── WhatsApp (AiSensy — currently disabled; leave blank) ──
AISENSY_API_URL=
AISENSY_WEBHOOK_SECRET=

# ── PostHog (server-side analytics; same project token as client) ──
POSTHOG_PROJECT_TOKEN=                    # phc_... — leave blank to disable server events
POSTHOG_HOST=https://us.i.posthog.com

# ── Server-side conversion fan-out (GA4 Measurement Protocol + Meta CAPI) ──
#   Reports money events server-side so conversions survive ad-blockers/ITP/cookie
#   death. Each tool is OFF until BOTH of its keys are set. (utils/trackServer.js)
GA4_MEASUREMENT_ID=                       # G-XXXXXXXXXX (same stream as client)
GA4_API_SECRET=                           # GA4 → Admin → Data Streams → MP API secret
FB_PIXEL_ID=                              # numeric Meta pixel id (same as client)
FB_CAPI_ACCESS_TOKEN=                     # Events Manager → Conversions API → access token
FB_TEST_EVENT_CODE=                       # optional: route to Meta Test Events tab while testing
# FB_API_VERSION=v19.0                    # optional override

# ── Tuning (optional; sane defaults in code) ──
BADGE_EVAL_INTERVAL_MIN=
LEDGER_RECONCILE_INTERVAL_MIN=
AUTO_COMPLETE_INTERVAL_MIN=               # cron cadence for auto-completing elapsed bookings (default 15)
AUTO_COMPLETE_HOLD_MIN=                   # post-session dispute/refund buffer before completion (default 120)
AUTO_COMPLETE_CUTOFF=                     # ISO date; sessions ended before it are never auto-completed. Set to the deploy timestamp to suppress first-run backfill (default: 3 days before boot)
PERF_LOG=true                             # set "false" in prod to quiet per-request timing logs
